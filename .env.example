# Required for /api/chat (OpenAI-compatible models via @ai-sdk/openai).
OPENAI_API_KEY=

# Optional model id (default: gpt-5.5).
OPENAI_MODEL=gpt-5.5

# Optional path to "PM Interview Data - Query result.csv" during `npm run ingest:data`.
# Default: ../PM Interview Data - Query result.csv relative to this project folder.
# On Vercel, ensure PM_DATA_CSV is available at build time, or ship prebuilt data/*.sqlite + data/*.json artifacts.
# A copy of the source CSV is written to data/pm-source.csv during ingest (gitignored) alongside pm.sqlite.
PM_DATA_CSV=

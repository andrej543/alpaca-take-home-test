# Required for /api/chat (OpenAI-compatible models via @ai-sdk/openai).
OPENAI_API_KEY=

# Optional model id (default: gpt-5.5).
OPENAI_MODEL=gpt-5.5

# Optional: override CSV path for `npm run ingest:data`.
# Default: source-data/pm-interview-query-result.csv (committed; build-only, not bundled into serverless).
# Generated DB + JSON live under data/ (rebuilt by prebuild).
PM_DATA_CSV=
